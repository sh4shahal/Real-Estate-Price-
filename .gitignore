# ─────────────────────────────────────────
#  Real Estate Price — Root .gitignore
#  Covers: Django backend + React/Vite frontend
# ─────────────────────────────────────────


# ══════════════════════════════════════════
#  PYTHON / DJANGO  (real-estate-backend)
# ══════════════════════════════════════════

# Byte-compiled / optimised files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environment
venv/
env/
.venv/
.env/

# Environment variables
.env
.env.local
.env.production

# Django
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_root/

# ML model files (large binary files)
*.pkl
*.joblib
*.h5
*.model
*.sav
predictor/models/*.pkl
predictor/models/*.joblib

# FAISS index files
*.index
*.faiss

# Migrations (optional — remove these 2 lines if you want to track migrations)
# */migrations/*.py
# !*/migrations/__init__.py

# Coverage / test reports
.coverage
htmlcov/
.pytest_cache/

# Jupyter notebooks checkpoints
.ipynb_checkpoints/
*.ipynb

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg


# ══════════════════════════════════════════
#  NODE / REACT / VITE  (real-estate-frontend)
# ══════════════════════════════════════════

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
out/

# Vite cache
.vite/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lock files (keep one — remove the others you don't use)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml


# ══════════════════════════════════════════
#  EDITORS & IDEs
# ══════════════════════════════════════════

# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains (PyCharm / WebStorm)
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~


# ══════════════════════════════════════════
#  OPERATING SYSTEM
# ══════════════════════════════════════════

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encdata
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~


# ══════════════════════════════════════════
#  MISCELLANEOUS
# ══════════════════════════════════════════

# Temp files
temp.py
test.txt
*.tmp
*.bak
*.orig

# Secrets / API keys (never commit these)
secrets.json
*secret*
*api_key*